# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo já funcionam com um PostgreSQL local (usuário/senha postgres).

PORT=4444

DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_quote
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# Segredo dos tokens (mínimo 32 caracteres). Sem ele a API não sobe. Gere um
# novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo serve SÓ para rodar localmente.
JWT_SECRET=segredo-local-somente-para-demonstracao-troque-0001

# Endereços do front liberados no CORS, separados por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180

# Endereço público desta API (monta a URL dos anexos gravados localmente).
PUBLIC_API_URL=http://localhost:4444

# Tentativas de login por IP a cada 15 minutos.
LOGIN_RATE_LIMIT=10

# Anexos dos pedidos de desconto. Com as quatro variáveis do Bunny.net
# preenchidas, o arquivo vai para a Storage Zone; vazio, fica em UPLOADS_DIR e
# é servido pela própria API em /uploads.
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_BASE=
BUNNY_FOLDER=anexos-desconto
UPLOADS_DIR=./uploads

# Log detalhado de cada requisição no console (1 = ligado).
API_DEBUG=0
